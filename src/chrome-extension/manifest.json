{
  "manifest_version": 3,
  "name": "VOCABWORLD AI Lookup",
  "version": "1.0.0",
  "description": "AI-powered vocabulary lookup and flashcards for VOCABWORLD AI",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
